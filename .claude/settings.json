{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(composer lint)",
      "Bash(composer format)",
      "Bash(composer phpstan)",
      "Bash(composer gen-stubs)",
      "Bash(composer install)",
      "Bash(composer update)",
      "Bash(vendor/bin/phpunit*)",
      "Bash(vendor/bin/phpcs*)",
      "Bash(vendor/bin/phpcbf*)",
      "Bash(vendor/bin/phpstan*)",
      "Bash(vendor/bin/cghooks*)",
      "Bash(npm install)",
      "Bash(npm run i18n*)",
      "Bash(npx grunt *)",
      "Bash(ls *)",
      "Bash(find * -name \"*.php\" *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(composer remove *)",
      "Bash(npm uninstall *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null || exit 0; f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.php) ;; *) exit 0 ;; esac; cd \"$CLAUDE_PROJECT_DIR\" && [ -x vendor/bin/phpcs ] || exit 0; out=$(vendor/bin/phpcs --standard=phpcs.xml.dist --report=summary --runtime-set ignore_warnings_on_exit 1 \"$f\" 2>/dev/null) && exit 0; echo \"$out\" >&2; exit 2"
          }
        ]
      }
    ]
  }
}
